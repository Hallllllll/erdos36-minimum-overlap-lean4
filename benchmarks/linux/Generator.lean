import Lean

/-!
Generate one direct or packed Lean benchmark module from a contiguous slice of
the committed certificate. The arithmetic uses `Nat`, so event coefficients are
never rounded through a shell or floating-point type.
-/

namespace BenchmarksLinux.Generator

def usage : String :=
  "usage: lean --run Generator.lean MODE CELLS OFFSET DENOMINATOR HEIGHTS OUTPUT"

def parseNat (label value : String) : IO Nat :=
  match value.toNat? with
  | some number => pure number
  | none => throw <| IO.userError s!"invalid {label}: {value}"

def readHeights (path : String) : IO (Array Nat) := do
  let text ← IO.FS.readFile path
  let values :=
    text.splitOn "\n"
      |>.filterMap fun line =>
        if line.isEmpty then none else line.toNat?
  pure values.toArray

partial def treeExpr
    (items : Array String) (low high : Nat) (indent : String) : String :=
  if high <= low then
    ""
  else if high = low + 1 then
    indent ++ "(Overlap.Tree.leaf " ++ items[low]! ++ ")"
  else
    let middle := low + (high - low) / 2
    let childIndent := indent ++ "  "
    indent ++ "(Overlap.Tree.node\n" ++
      treeExpr items low middle childIndent ++ "\n" ++
      treeExpr items middle high childIndent ++ "\n" ++
      indent ++ ")"

def naturalLeaves (values : Array Nat) : Array String :=
  values.map toString

def countDistinct (values : Array Nat) : Nat :=
  let distinct := values.foldl
    (fun seen value =>
      if value ∈ seen then seen else value :: seen)
    []
  distinct.length

def eventBounds (cells eventIndex : Nat) : Nat × Nat :=
  if eventIndex + 1 >= cells then
    let first := eventIndex + 1 - cells
    (first, cells)
  else
    (0, eventIndex + 1)

def correspondingIndex (cells eventIndex index : Nat) : Nat :=
  if eventIndex + 1 >= cells then
    index - (eventIndex + 1 - cells)
  else
    index + (cells - 1 - eventIndex)

def eventValue
    (values : Array Nat) (denominator cells eventIndex : Nat) : Nat :=
  let (first, afterLast) := eventBounds cells eventIndex
  List.range (afterLast - first)
    |>.foldl
      (fun total offset =>
        let index := first + offset
        let other := correspondingIndex cells eventIndex index
        total + values[index]! * (denominator - values[other]!))
      0

def directEventExpr
    (values : Array Nat) (denominator cells eventIndex : Nat) : String :=
  let (first, afterLast) := eventBounds cells eventIndex
  let terms :=
    List.range (afterLast - first)
      |>.map fun offset =>
        let index := first + offset
        let other := correspondingIndex cells eventIndex index
        s!"({values[index]!} * ({denominator} - {values[other]!}))"
  "(" ++ String.intercalate " + " terms ++ ")"

def directEvents
    (values : Array Nat) (denominator cells : Nat) : Array String :=
  Array.mk <| (List.range (2 * cells - 1)).map fun eventIndex =>
    directEventExpr values denominator cells eventIndex

def expectedEvents
    (values : Array Nat) (denominator cells : Nat) : Array Nat :=
  Array.mk <| (List.range (2 * cells - 1)).map fun eventIndex =>
    eventValue values denominator cells eventIndex

def validate
    (mode : String) (cells offset denominator : Nat) (values : Array Nat) : IO Unit := do
  if mode != "direct" && mode != "packed" then
    throw <| IO.userError s!"invalid mode: {mode}"
  if cells < 2 then
    throw <| IO.userError "benchmark requires at least two cells"
  if values.size != cells then
    throw <| IO.userError s!"expected {cells} heights, received {values.size}"
  if denominator = 0 then
    throw <| IO.userError "denominator is zero"
  if values.any (fun value => value > denominator) then
    throw <| IO.userError "height outside [0, denominator]"
  let positiveInterior := values.filter (fun value => 0 < value && value < denominator)
  if 2 * positiveInterior.size < cells then
    throw <| IO.userError "degenerate slice: fewer than half the heights are interior"
  if 4 * countDistinct values < cells then
    throw <| IO.userError "degenerate slice: too few distinct heights"
  if offset + cells > 9408 then
    throw <| IO.userError "slice exceeds the 9,408-cell construction"

def sourceFor
    (mode : String) (cells offset denominator : Nat) (values : Array Nat) : String :=
  let inputTree := treeExpr (naturalLeaves values) 0 values.size "  "
  let events := expectedEvents values denominator cells
  let expectedTree := treeExpr (naturalLeaves events) 0 events.size "  "
  let header :=
    "-- Generated by benchmarks/linux/Generator.lean.\n" ++
    s!"-- mode={mode} cells={cells} offset={offset} denominator={denominator}\n" ++
    "import Overlap.Tree\n\n" ++
    "namespace BenchmarksLinux\n\n" ++
    "set_option maxRecDepth 1000000\n" ++
    "set_option maxHeartbeats 0\n\n" ++
    s!"def input{cells} : Overlap.Tree :=\n{inputTree}\n\n" ++
    s!"def expected{cells} : Overlap.Tree :=\n{expectedTree}\n\n"
  if mode = "packed" then
    header ++
      s!"theorem packedCheck{cells} :\n" ++
      s!"  input{cells}.pack (2 ^ 128) * input{cells}.other (2 ^ 128) {denominator} =\n" ++
      s!"    expected{cells}.pack (2 ^ 128) := by decide +kernel\n\n" ++
      s!"#print axioms packedCheck{cells}\n\n" ++
      "end BenchmarksLinux\n"
  else
    let directTree := treeExpr (directEvents values denominator cells) 0 (2 * cells - 1) "  "
    header ++
      s!"def direct{cells} : Overlap.Tree :=\n{directTree}\n\n" ++
      s!"theorem directCheck{cells} :\n" ++
      s!"  direct{cells}.items = expected{cells}.items := by decide +kernel\n\n" ++
      s!"#print axioms directCheck{cells}\n\n" ++
      "end BenchmarksLinux\n"

def main (arguments : List String) : IO UInt32 := do
  match arguments with
  | [mode, cellsArg, offsetArg, denominatorArg, heightsPath, outputPath] =>
      let cells ← parseNat "cells" cellsArg
      let offset ← parseNat "offset" offsetArg
      let denominator ← parseNat "denominator" denominatorArg
      let values ← readHeights heightsPath
      validate mode cells offset denominator values
      let source := sourceFor mode cells offset denominator values
      let output ← IO.FS.Handle.mk outputPath .write
      output.putStr source
      IO.println (
        s!"generated mode={mode} cells={cells} offset={offset} " ++
        s!"distinct_heights={countDistinct values} source_bytes={source.length}")
      pure 0
  | _ =>
      IO.eprintln usage
      pure 2

end BenchmarksLinux.Generator

def main (arguments : List String) : IO UInt32 :=
  BenchmarksLinux.Generator.main arguments
